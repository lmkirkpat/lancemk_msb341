      "enabled": true,
      "active": true,
      "error": null,
      "text": "// Rock shake with multiple impacts (Position + shared array)\namps = [6,12,20];   // amplitude in pixels\nfreq = 8;  // shakes per second\ndecays = [1,4,10];  // how quickly it settles\n\n// Times of hammer hits (seconds)\nimpacts = [0.5, 1.5, 2.5];\n\noffset = [0,0];\n\nfor (i = 0; i < impacts.length; i++){\n  t = time - impacts[i];\n  if (t >= 0){\n\t  amp=amps[1];\n\t  decay=decays[1];\n    offset += [Math.sin(freq*t*2*Math.PI)/Math.exp(decay*t)*amp,\n               Math.cos(freq*t*2*Math.PI)/Math.exp(decay*t)*amp];\n  }\n}\n\nvalue + offset\n",
      "text_length": 530,
      "text_cut": false
    },
    {
      "layer": 4,
      "path": "ADBE Transform Group/ADBE Rotate Z",
      "display_path": "Transform › Rotation",
      "group": "transform",
      "keys": 0,
      "enabled": true,
      "active": true,
      "error": null,
      "text": "// Rock shake with multiple impacts (Rotation + shared array)\namps = [.25,.5,.75];    // amplitude in degrees\nfreq = 10;\ndecay = 3;\n\n// Same impact times as Position\nimpacts = [0.5, 1.5, 2.5];\n\nrot = 0;\n\nfor (i = 0; i < impacts.length; i++){\n  t = time - impacts[i];\n  if (t >= 0){\n\t  amp=amps[i];\n    rot += Math.sin(freq*t*2*Math.PI)/Math.exp(decay*t)*amp;\n  }\n}\n\nvalue + rot\n",
