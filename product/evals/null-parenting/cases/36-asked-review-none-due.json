        "turns": [
          1
        ]
      },
      {
        "id": "nothing_about_schedule",
        "never": "\\bdue\\b|\\boverdue\\b|\\bearly\\b|\\bschedule|since you asked|isn['’]t (?:due|time)|not (?:due|yet)|\\bnot scheduled",
