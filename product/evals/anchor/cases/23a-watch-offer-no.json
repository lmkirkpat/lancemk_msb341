    "say": [
      {
        "id": "offers_needle",
        "must": "\\b(?:show|watch)\\b[^.?!]{0,50}\\bNeedle\\b|\\bNeedle\\b[^.?!]{0,50}\\b(?:first|watch)\\b",
        "turns": [
          2
        ]
      },
      {
        "id": "offer_is_last",
        "must": "Needle[^.?!]*[.?!]*\\s*$",
        "turns": [
          2
        ]
      },
      {
        "id": "offered_once",
        "must": "\\b(?:show|watch)\\b[^.?!]{0,50}\\bNeedle\\b|\\bNeedle\\b[^.?!]{0,50}\\b(?:first|watch)\\b",
        "at_most": 1
      },
      {
        "id": "no_offer_after_check",
