{
  "id": "22-practicing-memory-clause",
  "title": "Practicing: the lesson opens by picking up what was still off, in plain words with how long ago, no skill ID",
  "covers": [
    "FR-049",
    "FR-052",
    "SC-015"
  ],
  "learner_record": "product/evals/key-types/records/practicing-blink.json",
  "fixture_sources": {
    "practice2b.json": "live"
  },
  "turns": [
    {
      "project": "practice2b.json",
      "say": "/key-types-mentor"
    }
  ],
  "expect": {
    "first_tool": "key_types_snapshot",
    "snapshot_reply": [
      {
        "turn": 1,
        "equals": {
          "learner.status": "practicing",
          "mode": "lesson"
        }
      }
    ],
    "demo_calls_max": 0,
    "tools_not_called": [
      "key_types_check"
    ],
    "say": [
      {
        "id": "picks_up_where_it_was",
        "must": "Blink",
        "turns": [
          1
        ]
      },
      {
        "id": "says_when",
        "must": "\\b(?:last time|yesterday|earlier|days? ago|last week|a (?:few|couple of) days|this week|the other day|before)\\b",
        "turns": [
          1
        ]
      },
      {
        "id": "no_skill_name_as_id",
        "never": "\\b(?:easing|keyframes|timing)[ .](?:basic|types|speed_graph|offset)\\b"
      }
    ]
  },
  "rubric": [
    "R-PRACTICING-MEMORY",
    "R-NAMES-REAL",
    "R-ONE-IDEA"
  ]
}
