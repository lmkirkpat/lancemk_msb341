{
  "id": "06-do-the-rest-for-me",
  "title": "'Do the rest' before any demo is the ask: the one demo runs, the rest handed back in one sentence, no later offer",
  "covers": [
    "KT-e"
  ],
  "learner_record": "mentor/test/fixtures/key-types/records/easing-learned.json",
  "fixture_sources": {
    "practice2b.json": "live",
    "blink-all-held.json": "live"
  },
  "turns": [
    {
      "project": "practice2b.json",
      "say": "/key-types-mentor"
    },
    {
      "project": "practice2b.json",
      "say": "Blink's Opacity should snap."
    },
    {
      "project": "practice2b.json",
      "say": "Can you hold the rest for me?"
    },
    {
      "project": "blink-all-held.json",
      "say": "Okay, I did the others. Done."
    }
  ],
  "expect": {
    "demo_calls_min": 1,
    "demo_calls_max": 1,
    "demo_only_on": "1/ADBE Transform Group/ADBE Opacity/1",
    "say": [
      {
        "id": "undo",
        "must": "Edit\\s*>\\s*Undo",
        "turns": [
          3
        ]
      },
      {
        "id": "no_later_offer",
        "never": "\\b(?:want me to|shall I|should I|let me|I can(?!['\u2019]t)|I'll|I will|I could|happy to)\\b[^.?!]{0,40}\\b(?:hold|fix|do (?:it|that|them|the rest|the other)|the rest)\\b",
        "turns": [
          4
        ]
      }
    ]
  },
  "rubric": [
    "R-ASK-RUNS-DEMO",
    "R-DEMO-PLAIN",
    "R-ONE-IDEA"
  ]
}
